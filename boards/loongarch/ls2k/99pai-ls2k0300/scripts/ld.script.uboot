/* Boot from u-boot (CONFIG_LS2K_UBOOT_BOOT):
 *
 * The whole image is linked and runs from DDR.  u-boot loads the binary at
 * PHYS_TO_CACHED(0x03000000) == 0x9000000003000000 and jumps there.  All
 * sections (code, read-only data and writable data) share a single region so
 * that the load address equals the link address (LMA == VMA): no copy table
 * / Flash-to-RAM copy is required.  The exception vectors are placed at the
 * fixed offsets 0x1000 (EBASE) and 0x2000 (TLBREBASE) relative to the load
 * address, matching the values programmed by __start in ls_head.S.
 *
 * DDR occupies the physical range 0x00000000 - 0x0fffffff (256MB), mapped
 * through the cached window 0x90000000_00000000 - 0x90000000_0fffffff.
 */

MEMORY
{
  /* 0x03000000 .. 0x0fffffff (image load base .. top of DDR) */
  ram (rwx) : ORIGIN = 0x9000000003000000, LENGTH = 0x0d000000
}

OUTPUT_ARCH("loongarch")

ENTRY(__start)

SECTIONS
{
    .text : {
        _stext = ABSOLUTE(.);
        *(.text.__start)
        . = ALIGN(0x1000);
        KEEP(*(.text.exception_vector))
        . = ALIGN(0x1000);
        KEEP(*(.text.tlb_exception_vector))
        *(.text.ls_lowlevel_init)
        *(.text.ls_clk_init)
        *(.text.ls_lock_scache)
        *(.text .text.*)
        *(.fixup)
        *(.gnu.warning)
        *(.rodata .rodata.* .srodata .srodata.*)
        *(.gnu.linkonce.t.*)
        *(.glue_7)
        *(.glue_7t)
        *(.got)
        *(.gcc_except_table)
        *(.gnu.linkonce.r.*)
        _etext = ABSOLUTE(.);
    } > ram

    .eh_frame : ALIGN(8) {
        KEEP(*(.eh_frame))
    } > ram

    .init_section : ALIGN(4) {
        _sinit = ABSOLUTE(.);
        KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*) SORT_BY_INIT_PRIORITY(.ctors.*)))
        KEEP(*(.init_array EXCLUDE_FILE(*crtbegin.o *crtbegin?.o *crtend.o *crtend?.o) .ctors))
        _einit = ABSOLUTE(.);
    } > ram

    .data : ALIGN(8) {
        _eronly = LOADADDR(.data);
        _sdata = ABSOLUTE(.);
        *(.data .data.*)
        *(.sdata .sdata.* .sdata2.*)
        *(.gnu.linkonce.d.*)
        *(.gnu.linkonce.s.*)
        CONSTRUCTORS
        . = ALIGN(8);
        _edata = ABSOLUTE(.);
    } > ram

    .bss : ALIGN(8) {
        _sbss = ABSOLUTE(.);
        *(.bss .bss.*)
        *(.sbss .sbss.*)
        *(.gnu.linkonce.b.*)
        *(.gnu.linkonce.sb.*)
        *(COMMON)
        . = ALIGN(32);
        _ebss = ABSOLUTE(.);
    } > ram

    .stab 0 : { *(.stab) }
    .stabstr 0 : { *(.stabstr) }
    .stab.excl 0 : { *(.stab.excl) }
    .stab.exclstr 0 : { *(.stab.exclstr) }
    .stab.index 0 : { *(.stab.index) }
    .stab.indexstr 0 : { *(.stab.indexstr) }
    .comment 0 : { *(.comment) }
    .debug_abbrev 0 : { *(.debug_abbrev) }
    .debug_info 0 : { *(.debug_info) }
    .debug_line 0 : { *(.debug_line) }
    .debug_pubnames 0 : { *(.debug_pubnames) }
    .debug_aranges 0 : { *(.debug_aranges) }
}
