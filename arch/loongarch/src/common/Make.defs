# Specify our general Assembly files
CMN_ASRCS += loongarch_vectors.S loongarch_exception_common.S
CMN_ASRCS += loongarch_saveusercontext.S

# Specify C code within the common directory to be included
CMN_CSRCS += loongarch_initialize.c loongarch_swint.c
CMN_CSRCS += loongarch_allocateheap.c loongarch_createstack.c
CMN_CSRCS += loongarch_cpuidlestack.c loongarch_doirq.c loongarch_exit.c loongarch_exception.c
CMN_CSRCS += loongarch_getnewintctx.c loongarch_getintstack.c loongarch_initialstate.c
CMN_CSRCS += loongarch_modifyreg32.c loongarch_nputs.c loongarch_releasestack.c
CMN_CSRCS += loongarch_registerdump.c loongarch_stackframe.c loongarch_switchcontext.c
CMN_CSRCS += loongarch_usestack.c loongarch_tcbinfo.c

ifeq ($(CONFIG_ENABLE_ALL_SIGNALS),y)
  CMN_CSRCS += loongarch_sigdeliver.c loongarch_schedulesigaction.c
endif

ifneq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
  CMN_CSRCS += loongarch_idle.c
endif

ifeq ($(CONFIG_STACK_COLORATION),y)
  CMN_CSRCS += loongarch_checkstack.c
endif

ifeq ($(CONFIG_SCHED_THREAD_LOCAL),y)
  CMN_CSRCS += loongarch_tls.c
endif

ifeq ($(CONFIG_ARCH_FPU),y)
  CMN_ASRCS += loongarch_fpu.S
  CMN_CSRCS += loongarch_fpucmp.c
endif
