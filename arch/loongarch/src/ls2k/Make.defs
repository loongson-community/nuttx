include common/Make.defs

ifeq ($(CONFIG_ARCH_CHIP_LS2K0300),y)

CHIP_CSRCS  = ls_start.c ls_lowputc.c ls_irq.c
CHIP_CSRCS += ls_allocateheap.c ls_clockconfig.c
ifeq ($(CONFIG_16550_UART),y)
CHIP_CSRCS += ls_16550serial.c
endif

ifeq ($(CONFIG_LS_DMA),y)
CHIP_CSRCS += ls_dma.c
endif

ifeq ($(CONFIG_LS_RTC),y)
CHIP_CSRCS += ls_rtc.c
endif

ifeq ($(CONFIG_LS_I2C),y)
CHIP_CSRCS += ls_i2c.c
endif

ifeq ($(CONFIG_LS_TIM),y)
CHIP_CSRCS += ls_tim.c
endif

ifeq ($(CONFIG_LS_TIM_PWM),y)
CHIP_CSRCS += ls_tim_pwm.c
endif

ifeq ($(CONFIG_LS_PULSECOUNT),y)
CHIP_CSRCS += ls_pulsecount.c
endif

ifeq ($(CONFIG_LS_CAP),y)
CHIP_CSRCS += ls_capture.c ls_capture_lowerhalf.c
endif

ifeq ($(CONFIG_LS_QE),y)
CHIP_CSRCS += ls_qencoder.c
endif

ifeq ($(CONFIG_TIMER)$(CONFIG_LS_HAVE_IP_TIMERS),yy)
CHIP_CSRCS += ls_tim_lowerhalf.c
endif

ifeq ($(CONFIG_LS_ONESHOT),y)
CHIP_CSRCS += ls_oneshot.c
CHIP_CSRCS += ls_oneshot_lowerhalf.c
endif

ifeq ($(CONFIG_LS_FREERUN),y)
CHIP_CSRCS += ls_freerun.c
endif

ifeq ($(CONFIG_LS_PWM),y)
CHIP_CSRCS += ls_pwm.c
endif

ifeq ($(CONFIG_LS_SPI),y)
CHIP_CSRCS += ls_spi.c
endif

ifeq ($(CONFIG_LS_SPIIO),y)
CHIP_CSRCS += ls_spiio.c
endif

ifeq ($(CONFIG_LS_WDT),y)
CHIP_CSRCS += ls_wdt.c
endif

ifeq ($(CONFIG_LS_GPIO),y)
CHIP_CSRCS += ls_gpio.c
endif

ifeq ($(CONFIG_TIMER),y)
CHIP_CSRCS += ls_timerisr.c
endif

CHIP_ASRCS  = ls_head.S

endif
